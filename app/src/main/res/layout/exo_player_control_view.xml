<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <View android:id="@+id/exo_top"
      android:layout_width="match_parent"
      android:layout_height="130dp"
      android:background="@drawable/scrim_top"
      android:layout_gravity="top" />

  <FrameLayout android:id="@+id/exo_controls_background"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center"
      android:layoutDirection="ltr" />

  <View android:id="@+id/exo_scrim_bottom"
      android:layout_width="match_parent"
      android:layout_height="170dp"
      android:background="@drawable/scrim_bottom"
      android:layout_gravity="bottom" />

  <!-- Top row: thin chevron + title, aligned with the reference -->
  <LinearLayout android:id="@+id/top_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top|start"
      android:layoutDirection="ltr"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:paddingTop="25dp">

    <ImageButton android:id="@+id/exo_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:src="@drawable/ic_p_back"
        android:contentDescription="Back" />

    <TextView android:id="@+id/player_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:textSize="17sp"
        android:textColor="#F2FFFFFF"
        android:textDirection="locale" />

  </LinearLayout>

  <!-- Single low control bar: CC | speaker | time ... rew | play | fwd ... speed | aspect -->
  <FrameLayout android:id="@+id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:layout_gravity="bottom"
      android:layout_marginBottom="19dp"
      android:background="@android:color/transparent"
      android:paddingStart="28dp"
      android:paddingEnd="28dp"
      android:layoutDirection="ltr">

    <LinearLayout android:id="@+id/exo_left_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <ImageButton android:id="@+id/exo_subtitle"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="fitCenter"
          android:padding="12dp"
          android:src="@drawable/ic_p_subtitles"
          android:contentDescription="Subtitles" />

      <ImageButton android:id="@+id/exo_mute"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="8dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="fitCenter"
          android:padding="12dp"
          android:src="@drawable/ic_p_speaker"
          android:contentDescription="Mute" />

      <com.brouken.player.PositionTimeView android:id="@+id/exo_position"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="16dp"
          android:includeFontPadding="false"
          android:gravity="center_vertical"
          android:fontFeatureSettings="tnum"
          android:textSize="14sp"
          android:textColor="#FFFFFFFF" />

      <TextView android:id="@+id/exo_time_separator"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:layout_marginEnd="6dp"
          android:includeFontPadding="false"
          android:gravity="center_vertical"
          android:text="/"
          android:textSize="14sp"
          android:textColor="#FFFFFFFF" />

      <com.brouken.player.RemainingTimeView android:id="@+id/exo_duration"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:gravity="center_vertical"
          android:fontFeatureSettings="tnum"
          android:textSize="14sp"
          android:textColor="#FFFFFFFF" />

    </LinearLayout>

    <LinearLayout android:id="@+id/exo_center_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <ImageButton android:id="@+id/exo_rew"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="fitCenter"
          android:padding="12dp"
          android:src="@drawable/ic_p_rew10"
          android:contentDescription="Rewind 10 seconds" />

      <ImageButton android:id="@+id/exo_play_pause"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="28dp"
          android:layout_marginEnd="28dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="fitCenter"
          android:padding="12dp"
          android:contentDescription="Play" />

      <ImageButton android:id="@+id/exo_ffwd"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="fitCenter"
          android:padding="12dp"
          android:src="@drawable/ic_p_fwd10"
          android:contentDescription="Forward 10 seconds" />

    </LinearLayout>

    <LinearLayout android:id="@+id/exo_right_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <ImageButton android:id="@+id/exo_speed"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="fitCenter"
          android:padding="12dp"
          android:src="@drawable/ic_p_speed"
          android:contentDescription="Speed" />

      <ImageButton android:id="@+id/exo_settings"
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:visibility="gone" />

    </LinearLayout>

  </FrameLayout>

  <com.brouken.player.CustomDefaultTimeBar android:id="@+id/exo_progress"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_progress_layout_height"
      android:layout_gravity="bottom"
      android:layout_marginStart="28dp"
      android:layout_marginEnd="28dp"
      android:layout_marginBottom="@dimen/exo_styled_progress_margin_bottom"
      app:bar_height="@dimen/exo_styled_progress_bar_height"
      app:bar_gravity="bottom"
      app:touch_target_height="@dimen/exo_styled_progress_touch_target_height"
      app:scrubber_enabled_size="@dimen/exo_styled_progress_enabled_thumb_size"
      app:scrubber_dragged_size="@dimen/exo_styled_progress_dragged_thumb_size"
      app:ad_marker_width="@dimen/marker_width"
      app:played_color="#FFFFFFFF"
      app:scrubber_color="#FFFFFFFF"
      app:buffered_color="@color/progress_buffered"
      app:unplayed_color="@color/progress_unplayed"
      app:ad_marker_color="@android:color/transparent"
      app:played_ad_marker_color="@android:color/transparent" />

  <LinearLayout android:id="@+id/exo_center_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center"
      android:orientation="horizontal">

    <ImageButton android:id="@+id/delete"
        style="@style/ExoStyledControls.Button.Center.Secondary"
        android:src="@drawable/exo_styled_controls_delete"
        android:visibility="gone" />

    <ImageButton android:id="@+id/next"
        style="@style/ExoStyledControls.Button.Center.Secondary"
        android:src="@drawable/exo_styled_controls_next"
        android:visibility="gone" />

    <ProgressBar android:id="@+id/loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

  </LinearLayout>

  <View android:id="@+id/exo_left"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:background="@color/exo_black_opacity_70"
      android:layout_gravity="left" />

  <View android:id="@+id/exo_right"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:background="@color/exo_black_opacity_70"
      android:layout_gravity="right" />

</merge>
